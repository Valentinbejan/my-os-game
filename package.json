{
  "name": "signal-91",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/desktop.mjs build --no-bundle",
    "build:web": "tsc --noEmit && vite build",
