    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/notices.mjs",
    "package:demo": "node scripts/package-demo.mjs",
    "package:itch": "node scripts/package-itch.mjs"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.3.0",
