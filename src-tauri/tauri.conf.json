{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIGNAL91",
  "version": "1.0.0",
  "identifier": "com.aegis.signal91",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIGNAL/91",
        "width": 1280,
        "height": 900,
        "minWidth": 420,
        "minHeight": 440,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#080a08"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
